<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tredye.alerts</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--no-warnings</string>
    <string>/path/to/tredye-noti/src/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/tredye-noti</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/path/to/tredye-noti/data/service.out.log</string>

  <key>StandardErrorPath</key>
  <string>/path/to/tredye-noti/data/service.err.log</string>
</dict>
</plist>

