# Tredye Account Credentials (used to authenticate with https://www.tredye.com/api/auth/login)
TREDYE_EMAIL=
TREDYE_PASSWORD=

# Optional: Direct session cookie header if you sign in via browser (e.g. Google login)
# Copy the Cookie header value from Chrome DevTools -> Network -> /api/orderflow
TREDYE_COOKIE=

# Local Dashboard Server Port
PORT=4600

# macOS Desktop Notifications (true/false)
MAC_NOTIFY=true

# Optional: Telegram Bot Notifications (for phone alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstox API Credentials (for real-time quotes, depth, intraday candles & WebSocket V3)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4600/api/upstox/callback
UPSTOX_ACCESS_TOKEN=

# Poll outside NSE market hours too (true/false). Default false (polls 09:15-15:30 IST Mon-Fri, plus once on startup)
POLL_ALWAYS=false

