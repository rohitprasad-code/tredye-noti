{
  "name": "tredye-flow-alerts",
  "version": "1.0.0",
  "description": "Order-flow reminder notifications from Tredye Pulse. Never places trades.",
  "private": true,
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "demo": "node src/index.js --demo",
    "dry-run": "node --env-file-if-exists=.env src/index.js --dry-run",
    "test": "node --test test/engine.test.js"
  }
}
